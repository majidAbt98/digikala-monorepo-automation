# Digikala Automation Platform — Environment Variables
# Copy to .env and update values for your environment

# PostgreSQL
AP_POSTGRES_PASSWORD=change_me_strong_password

# Security (generate with: openssl rand -hex 16)
AP_ENCRYPTION_KEY=change_me_32_characters_exactly!!
AP_JWT_SECRET=change_me_jwt_secret_strong_value

# Frontend URL (your public-facing URL)
AP_FRONTEND_URL=http://localhost:8080
